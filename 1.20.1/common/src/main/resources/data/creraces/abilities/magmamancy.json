{
    "creraces:name": "ability.creraces.magmamancy.name",
    "creraces:description": "ability.creraces.magmamancy.description",
    "creraces:type": "ACTIVE",
    "creraces:icon": "minecraft:textures/item/lava_bucket.png",
    "creraces:cooldown": 20,
    "creraces:cost": 50,
    "creraces:race": [
        "creraces:oread"
    ],
    "creraces:actions": [
        {
            "type": "creraces:conditional",
            "condition": {
                "type": "creraces:sneaking"
            },
            "if_true": [
                {
                    "type": "creraces:toggle_state",
                    "state": "self",
                    "on_value": 1,
                    "off_value": 0,
                    "on_enable": [
                        {
                            "type": "creraces:message",
                            "text": "§6Molten Being: ON"
                        }
                    ],
                    "on_disable": [
                        {
                            "type": "creraces:message",
                            "text": "§7Molten Being: OFF"
                        }
                    ]
                }
            ],
            "if_false": [
                {
                    "type": "creraces:conditional",
                    "condition": {
                        "type": "creraces:and",
                        "conditions": [
                            {
                                "type": "creraces:resource_level",
                                "resource": "custom:stored_material",
                                "operator": ">=",
                                "value": 1
                            },
                            {
                                "type": "creraces:not",
                                "condition": {
                                    "type": "creraces:on_ground"
                                }
                            }
                        ]
                    },
                    "if_true": [
                        {
                            "type": "creraces:modify_resource",
                            "resource": "custom:stored_material",
                            "operation": "add",
                            "value": -1
                        },
                        {
                            "type": "creraces:place_block",
                            "block": "minecraft:magma_block"
                        },
                        {
                            "type": "creraces:play_sound",
                            "sound": "minecraft:block.lava.ambient",
                            "volume": 1.0,
                            "pitch": 0.5
                        }
                    ]
                }
            ]
        }
    ],
    "creraces:wiki_page": "Ability:Magmamancy"
}




