{
    "creraces:name": "race.creraces.naiad.name",
    "creraces:parent_races": [
        "creraces:nymph",
        "creraces:aquatic"
    ],
    "creraces:enable_territory": true,
    "creraces:index": 9.2,
    "creraces:description": "race.creraces.naiad.description",
    "creraces:icon": "creraces:textures/screens/naiad_icon.png",
    "creraces:splash": "creraces:textures/screens/naiad_splash.png",
    "creraces:portrait": "creraces:textures/screens/naiad_portrait.png",
    "creraces:name_texture": "creraces:textures/screens/naiad_text.png",
    "creraces:resource_type": "MANA",
    "creraces:gstate": "FEMALE",
    "creraces:starting_abilities": [
        "creraces:tidal_wave",
        "creraces:whirlpool",
        "creraces:quick_current",
        "creraces:camouflage"
    ],
    "aquatic_buffs": [
        {
            "name": "aquatic_buffs",
            "type": "creraces:on_tick",
            "interval": 100,
            "condition": {
                "type": "creraces:in_water",
                "include_rain": false
            },
            "actions": [
                {
                    "type": "creraces:apply_effect",
                    "effect": "minecraft:strength",
                    "duration": 200,
                    "amplifier": 0
                },
                {
                    "type": "creraces:apply_effect",
                    "effect": "minecraft:conduit_power",
                    "duration": 200,
                    "amplifier": 0
                },
                {
                    "type": "creraces:apply_velocity",
                    "y": 0.05,
                    "relative": false
                }
            ]
        }
    ],
    "creraces:territory_valid_biomes": ["#minecraft:is_river"],
    "creraces:starting_items": [
        "creraces:oceanic_statue"
    ],
    "sapling_mechanics": [
        {
            "type": "creraces:block_place",
            "block": "creraces:oceanic_statue",
            "actions": [
                {
                    "type": "creraces:conditional",
                    "condition": {
                        "type": "creraces:state",
                        "state": "state:node_x",
                        "operator": "!=",
                        "value": 0.0
                    },
                    "if_true": [
                        { "type": "creraces:message", "text": "msg.creraces.naiad.already_has_node", "actionbar": true },
                        { "type": "creraces:cancel" }
                    ]
                },
                {
                    "type": "creraces:claim_territory",
                    "valid_biomes": ["#minecraft:is_river"],
                    "anchor_y_offset": 0,
                    "on_success": [
                        { "type": "creraces:modify_value", "resource": "state:node_x", "mode": "TARGET_BLOCK_X", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_y", "mode": "TARGET_BLOCK_Y", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_z", "mode": "TARGET_BLOCK_Z", "persistent": true },
                        { "type": "creraces:spawn_particles", "particle": "minecraft:happy_villager", "count": 15, "spread_x": 0.5, "spread_y": 0.5, "spread_z": 0.5, "use_target": true },
                        { "type": "creraces:play_sound", "sound": "minecraft:item.bone_meal.use", "volume": 1.0, "pitch": 1.0, "use_target": true },
                        { "type": "creraces:message", "text": "msg.creraces.naiad.claimed_success", "actionbar": true }
                    ],
                    "on_partial": [
                        { "type": "creraces:modify_value", "resource": "state:node_x", "mode": "TARGET_BLOCK_X", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_y", "mode": "TARGET_BLOCK_Y", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_z", "mode": "TARGET_BLOCK_Z", "persistent": true }
                    ],
                    "on_invalid_biome": [
                        { "type": "creraces:message", "text": "msg.creraces.naiad.invalid_biome", "actionbar": true },
                        { "type": "creraces:cancel" }
                    ],
                    "on_enemy_territory": [
                        { "type": "creraces:message", "text": "msg.creraces.naiad.enemy_territory", "actionbar": true }
                    ],
                    "on_inside_own": [
                        { "type": "creraces:modify_value", "resource": "state:node_x", "mode": "TARGET_BLOCK_X", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_y", "mode": "TARGET_BLOCK_Y", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_z", "mode": "TARGET_BLOCK_Z", "persistent": true },
                        { "type": "creraces:message", "text": "msg.creraces.naiad.node_relocated", "actionbar": true }
                    ]
                }
            ]
        },
        {
            "type": "creraces:block_interaction",
            "block": "creraces:oceanic_statue",
            "actions": [
                {
                    "type": "creraces:conditional",
                    "condition": {
                        "type": "creraces:and",
                        "conditions": [
                            { "type": "creraces:sneaking", "value": true },
                            { "type": "creraces:is_position", "use_target_block": true, "x": "state:node_x", "y": "state:node_y", "z": "state:node_z" }
                        ]
                    },
                    "if_true": [
                        { "type": "creraces:give_item", "item": "creraces:oceanic_statue", "amount": 1 },
                        { "type": "creraces:place_block", "block": "minecraft:air", "use_target_block": true, "overwrite": true },
                        { "type": "creraces:modify_value", "resource": "state:node_x", "value": 0.0, "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_y", "value": 0.0, "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_z", "value": 0.0, "persistent": true },
                        { "type": "creraces:message", "text": "msg.creraces.node_removed", "actionbar": true }
                    ]
                }
            ]
        }
    ],
    "cosmetics": [
        {
            "type": "creraces:addon",
            "addon_id": "moss"
        },
        {
            "type": "creraces:addon",
            "addon_id": "naiad_body"
        }
    ],
    "creraces:wiki_page": "Naiad",
    "creraces:splash_x": -7,
    "creraces:splash_y": 7,
    "creraces:splash_w": 200,
    "creraces:splash_h": 179,
    "creraces:name_tex_x": 51,
    "creraces:name_tex_y": -38,
    "creraces:name_tex_w": 72,
    "creraces:name_tex_h": 24,
    "creraces:bg_texture": "creraces:textures/screens/selection_water_bg.png"
}