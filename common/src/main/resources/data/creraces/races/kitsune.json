                    "particle": "minecraft:soul_fire_flame",
                    "count": { "base": 0, "scales_with": "custom:tail_count", "factor": 1 },
                    "speed": { "base": 0 },
                    "spin": { "base": 0.1 },
                    "shape": "circle",
                    "radius": { "base": 1.2 },
                    "points": { "base": 0, "scales_with": "custom:tail_count", "factor": 2 },
                    "axis": "y"
                }
            ]
        }
    ],
    "creraces:starting_abilities": ["creraces:foxfire", "creraces:fox_form", "creraces:kitsune_sleep"],
    "creraces:starting_items": ["creraces:mirror"],
    "creraces:customization": [
        {
            "id": "tail_count",
            "type": "property",
            "options": ["1", "2", "3", "4", "5", "6", "7", "8", "9"],
            "default": "1",
            "hidden": true
        },
        {
            "id": "ear_style",
            "type": "property",
            "options": ["standard", "alt"],
            "default": "standard",
            "addons": { "standard": "kitsune_ears_{color}", "alt": "kitsune_ears_{color}_alt" }
        },
        {
            "id": "snout",
            "type": "property",
            "options": ["true", "false"],
            "default": "false",
            "addons": { "true": "kitsune_snout_{color}" }
        },
        {
            "id": "tail_style",
            "type": "property",
            "options": ["standard", "alt"],
            "default": "standard",
            "addons": {
                "standard": "kitsune_tails_{tail_count}_{color}",
                "alt": [
                    {
                        "addon": "kitsune_tails_{tail_count}_{color}_alt",
                        "condition": {
                            "type": "creraces:customization",
                            "customization": "tail_count",
                            "values": ["3", "4", "5"]
                        }
                    },
                    "kitsune_tails_{tail_count}_{color}"
                ]
            }
        },
        {
            "id": "color",
            "type": "property",
            "options": ["yellow", "white", "black", "red", "blue", "purple", "orange"],
            "default": "orange"
        }
