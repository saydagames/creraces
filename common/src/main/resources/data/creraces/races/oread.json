            "condition": {
                "type": "creraces:and",
                "conditions": [
                    { "type": "creraces:compare", "value": "state:mountains_fury", "to": 1 },
                    {
                        "type": "creraces:compare",
                        "value": "state:creraces:stacks",
                        "to": 1000,
                        "operator": "<"
                    }
                ]
            },
            "actions": [
                {
                    "type": "creraces:modify_value",
                    "state": "creraces:stacks",
                    "operation": "add",
                    "value": 1
                }
            ]
        },
        {
            "id": "magmatic_metabolism",
            "type": "creraces:on_tick",
            "interval": 10,
            "condition": {
                "type": "creraces:and",
                "conditions": [
                    { "type": "creraces:sneaking" },
                    { "type": "creraces:has_item", "slot": "hands", "item": "#c:cobblestones" },
                    { "type": "creraces:compare", "value": "state:magmamancy", "to": 1 }
                ]
            },
            "actions": [
                { "type": "creraces:consume_item", "item": "#c:cobblestones", "amount": 1 },
                { "type": "creraces:modify_value", "resource": "food", "operation": "add", "value": 2 },
                { "type": "creraces:modify_value", "resource": "saturation", "operation": "add", "value": 2 },
                {
                    "type": "creraces:modify_value",
                    "state": "creraces:stored_material",
                    "operation": "add",
                    "value": 1
                },
                {
                    "type": "creraces:play_sound",
                    "sound": "minecraft:entity.generic.eat",
                    "volume": 0.5,
                    "pitch": 1.5
                }
            ]
        }
