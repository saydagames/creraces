                            }
                        ],
                        "on_inspect": [
                            {
                                "type": "creraces:message",
                                "text": "msg.creraces.tree_location_check",
                                "actionbar": true
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "pocket_dimension": [
