{
    "creraces:name": "race.creraces.aurai.name",
    "creraces:parent_race": "creraces:nymph",
    "creraces:enable_territory": true,
    "creraces:index": 9.4,
    "creraces:description": "race.creraces.aurai.description",
    "creraces:icon": "creraces:textures/screens/aurai_icon.png",
    "creraces:splash": "creraces:textures/screens/aurai_splash.png",
    "creraces:portrait": "creraces:textures/screens/aurai_portrait.png",
    "creraces:name_texture": "creraces:textures/screens/aurai_text.png",
    "creraces:resource_type": "MANA",
    "creraces:difficulty": 2,
    "creraces:regeneration_multiplier": 1.1,
    "creraces:negate_effects": [
        "creraces:dizziness"
    ],
    "creraces:starting_abilities": [
        "creraces:dash",
        "creraces:tornado",
        "creraces:smackdown",
        "creraces:low_pressure_area"
    ],
    "passive": [
        {
            "type": "creraces:flight",
            "condition": {
                "type": "creraces:not",
                "condition": {
                    "type": "creraces:or",
                    "conditions": [
                        {
                            "type": "creraces:and",
                            "conditions": [
                                { "type": "creraces:wearing_armor", "slot": "head" },
                                { "type": "creraces:not", "condition": { "type": "creraces:wearing_armor", "tag": "#c:light_armors", "slot": "head" } }
                            ]
                        },
                        {
                            "type": "creraces:and",
                            "conditions": [
                                { "type": "creraces:wearing_armor", "slot": "chest" },
                                { "type": "creraces:not", "condition": { "type": "creraces:wearing_armor", "tag": "#c:light_armors", "slot": "chest" } }
                            ]
                        },
                        {
                            "type": "creraces:and",
                            "conditions": [
                                { "type": "creraces:wearing_armor", "slot": "legs" },
                                { "type": "creraces:not", "condition": { "type": "creraces:wearing_armor", "tag": "#c:light_armors", "slot": "legs" } }
                            ]
                        },
                        {
                            "type": "creraces:and",
                            "conditions": [
                                { "type": "creraces:wearing_armor", "slot": "feet" },
                                { "type": "creraces:not", "condition": { "type": "creraces:wearing_armor", "tag": "#c:light_armors", "slot": "feet" } }
                            ]
                        }
                    ]
                }
            }
        },
        {
            "type": "creraces:on_tick",
            "interval": 5,
            "condition": {
                "type": "creraces:not",
                "condition": {
                    "type": "creraces:has_effect",
                    "effect": "creraces:nymph_call"
                }
            },
            "actions": [
                {
                    "type": "creraces:apply_velocity",
                    "y": 0.5
                }
            ]
        }
    ],
    "creraces:territory_valid_biomes": ["#c:is_plains"],
    "creraces:starting_items": [
        "creraces:angelic_sculpture"
    ],
    "sapling_mechanics": [
        {
            "type": "creraces:block_place",
            "block": "creraces:angelic_sculpture",
            "actions": [
                {
                    "type": "creraces:conditional",
                    "condition": {
                        "type": "creraces:state",
                        "state": "state:node_x",
                        "operator": "!=",
                        "value": 0.0
                    },
                    "if_true": [
                        { "type": "creraces:message", "text": "msg.creraces.aurai.already_has_node", "actionbar": true },
                        { "type": "creraces:cancel" }
                    ]
                },
                {
                    "type": "creraces:claim_territory",
                    "valid_biomes": ["#c:is_plains"],
                    "anchor_y_offset": 0,
                    "on_success": [
                        { "type": "creraces:modify_value", "resource": "state:node_x", "mode": "TARGET_BLOCK_X", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_y", "mode": "TARGET_BLOCK_Y", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_z", "mode": "TARGET_BLOCK_Z", "persistent": true },
                        { "type": "creraces:spawn_particles", "particle": "minecraft:happy_villager", "count": 15, "spread_x": 0.5, "spread_y": 0.5, "spread_z": 0.5, "use_target": true },
                        { "type": "creraces:play_sound", "sound": "minecraft:item.bone_meal.use", "volume": 1.0, "pitch": 1.0, "use_target": true },
                        { "type": "creraces:message", "text": "msg.creraces.aurai.claimed_success", "actionbar": true }
                    ],
                    "on_partial": [
                        { "type": "creraces:modify_value", "resource": "state:node_x", "mode": "TARGET_BLOCK_X", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_y", "mode": "TARGET_BLOCK_Y", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_z", "mode": "TARGET_BLOCK_Z", "persistent": true }
                    ],
                    "on_invalid_biome": [
                        { "type": "creraces:message", "text": "msg.creraces.aurai.invalid_biome", "actionbar": true },
                        { "type": "creraces:cancel" }
                    ],
                    "on_enemy_territory": [
                        { "type": "creraces:message", "text": "msg.creraces.aurai.enemy_territory", "actionbar": true }
                    ],
                    "on_inside_own": [
                        { "type": "creraces:modify_value", "resource": "state:node_x", "mode": "TARGET_BLOCK_X", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_y", "mode": "TARGET_BLOCK_Y", "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_z", "mode": "TARGET_BLOCK_Z", "persistent": true },
                        { "type": "creraces:message", "text": "msg.creraces.aurai.node_relocated", "actionbar": true }
                    ]
                }
            ]
        },
        {
            "type": "creraces:block_interaction",
            "block": "creraces:angelic_sculpture",
            "actions": [
                {
                    "type": "creraces:conditional",
                    "condition": {
                        "type": "creraces:and",
                        "conditions": [
                            { "type": "creraces:sneaking", "value": true },
                            { "type": "creraces:is_position", "use_target_block": true, "x": "state:node_x", "y": "state:node_y", "z": "state:node_z" }
                        ]
                    },
                    "if_true": [
                        { "type": "creraces:give_item", "item": "creraces:angelic_sculpture", "amount": 1 },
                        { "type": "creraces:place_block", "block": "minecraft:air", "use_target_block": true, "overwrite": true },
                        { "type": "creraces:modify_value", "resource": "state:node_x", "value": 0.0, "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_y", "value": 0.0, "persistent": true },
                        { "type": "creraces:modify_value", "resource": "state:node_z", "value": 0.0, "persistent": true },
                        { "type": "creraces:message", "text": "msg.creraces.node_removed", "actionbar": true }
                    ]
                }
            ]
        }
    ],
    "cosmetics": [
        {
            "type": "creraces:addon",
            "addon_id": "aurai_body"
        }
    ],
    "creraces:wiki_page": "Aurai",
    "creraces:splash_x": -7,
    "creraces:splash_y": -2,
    "creraces:splash_w": 200,
    "creraces:splash_h": 179,
    "creraces:name_tex_x": 50,
    "creraces:name_tex_y": -39,
    "creraces:name_tex_w": 73,
    "creraces:name_tex_h": 26,
    "creraces:bg_texture": "creraces:textures/screens/selection_air_bg.png"
}