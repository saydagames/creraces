{
    "creraces:name": "race.creraces.spring_fairy.name",
    "creraces:state": "unfinished",
    "creraces:index": 5.3,
    "creraces:description": "race.creraces.spring_fairy.description",
    "creraces:icon": "creraces:textures/screens/spring_fairy_icon.png",
    "creraces:splash": "creraces:textures/screens/spring_fairy_splash.png",
    "creraces:parent_races": ["creraces:fairy"],
    "creraces:resource_type": "mana",
    "creraces:difficulty": 2,
    "creraces:portrait": "creraces:textures/screens/spring_fairy_portrait.png",
    "creraces:name_texture": "creraces:textures/screens/spring_fairy_text.png",
    "creraces:wiki_page": "Spring_Fairy",
    "creraces:splash_x": -22,
    "creraces:splash_y": -12,
    "creraces:splash_w": 200,
    "creraces:splash_h": 200,
    "creraces:name_tex_x": 45,
    "creraces:name_tex_y": -39,
    "creraces:name_tex_w": 84,
    "creraces:name_tex_h": 26,
    "creraces:bg_texture": "creraces:textures/screens/selection_spring_bg.png",
    "creraces:selection_dimension": "creraces:fairy_realm",
    "creraces:selection_pos": { "x": 251.5, "y": 98, "z": -249.5 },
    "creraces:respawn_dimension": "creraces:fairy_realm",
    "creraces:respawn_pos": { "x": 251.5, "y": 98, "z": -249.5 },
    "passive": [
        {
            "id": "spring_broken_wings",
            "type": "creraces:on_tick",
            "interval": 20,
            "condition": {
                "type": "creraces:not",
                "condition": { "type": "creraces:biome_temperature", "min": 0.15, "max": 1 }
            },
            "on_fail": [
                {
                    "type": "creraces:conditional",
                    "condition": {
                        "type": "creraces:compare",
                        "value": "state:creraces:bw_exposure",
                        "to": 0,
                        "operator": ">"
                    },
                    "if_true": [
                        {
                            "type": "creraces:message",
                            "text": "msg.creraces.broken_wings_safe",
                            "actionbar": true
                        }
                    ]
                },
                { "type": "creraces:modify_value", "state": "creraces:bw_exposure", "value": 0 }
            ],
            "actions": [
                {
                    "type": "creraces:conditional",
                    "condition": {
                        "type": "creraces:not",
                        "condition": { "type": "creraces:has_effect", "effect": "creraces:broken_wings" }
                    },
                    "if_true": [
                        {
                            "type": "creraces:modify_value",
                            "state": "creraces:bw_exposure",
                            "operation": "add",
                            "value": 1
                        },
                        {
                            "type": "creraces:conditional",
                            "condition": {
                                "type": "creraces:compare",
                                "value": "state:creraces:bw_exposure",
                                "to": 60,
                                "operator": ">="
                            },
                            "if_true": [
                                {
                                    "type": "creraces:modify_value",
                                    "state": "creraces:bw_exposure",
                                    "value": 0
                                },
                                {
                                    "type": "creraces:apply_effect",
                                    "effect": "creraces:broken_wings",
                                    "duration": -1,
                                    "amplifier": 0,
                                    "ambient": false,
                                    "visible": false,
                                    "entity": "self"
                                },
                                { "type": "creraces:message", "text": "msg.creraces.broken_wings_broken" }
                            ],
                            "if_false": [
                                {
                                    "type": "creraces:conditional",
                                    "condition": {
                                        "type": "creraces:compare",
                                        "value": "state:creraces:bw_exposure",
                                        "to": 1,
                                        "operator": "=="
                                    },
                                    "if_true": [
                                        {
                                            "type": "creraces:message",
                                            "text": "msg.creraces.broken_wings_warning",
                                            "actionbar": true
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "creraces:overlay_bars": [
        {
            "source": "state:creraces:bw_exposure",
            "max": 60,
            "color": "#FF4500",
            "name": "gui.creraces.bar.climate_exposure"
        }
    ]
}
