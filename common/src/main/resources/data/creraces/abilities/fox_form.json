                    "type": "creraces:play_sound",
                    "sound": "minecraft:entity.fox.teleport",
                    "volume": 1,
                    "pitch": 1
                },
                {
                    "type": "creraces:change_size",
                    "scale": { "base": 1, "hitbox_height": 1, "eye_height": 1 }
                }
            ]
