            "if_true": [
                { "type": "creraces:morph", "entity_type": "twilight_lib:{color}_fox" },
                { "type": "creraces:bind", "slot": "a1", "ability": "creraces:dash", "save_to": "human_a1" },
                { "type": "creraces:modify_value", "state": "fox_form", "value": 1 },
                {
                    "type": "creraces:attribute_modifier",
                    "attribute": "minecraft:generic.movement_speed",
                    "id": "fox_form_speed",
                    "value": { "base": 0.02 }
                },
                {
                    "type": "creraces:attribute_modifier",
                    "attribute": "minecraft:generic.attack_damage",
                    "id": "fox_form_no_damage",
                    "value": { "base": -100 }
                },
                {
                    "type": "creraces:play_sound",
                    "sound": "minecraft:entity.fox.ambient",
                    "volume": 1,
                    "pitch": 1
                },
                {
                    "type": "creraces:change_size",
