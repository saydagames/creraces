{
    "creraces:name": "ability.creraces.magmamancy.name",
    "creraces:description": "ability.creraces.magmamancy.description",
    "creraces:type": "active",
    "creraces:icon": "creraces:volcanic_rock",
    "creraces:cooldown": 0,
    "creraces:cost": 0,
    "creraces:race": ["creraces:oread"],
    "creraces:actions": [
        {
            "type": "creraces:conditional",
            "condition": { "type": "creraces:sneaking" },
            "if_true": [
                { "type": "creraces:toggle_state", "state": "self" },
                { "type": "creraces:modify_value", "cooldown": "creraces:magmamancy", "value": 5 }
            ],
            "if_false": [
                {
                    "type": "creraces:conditional",
                    "condition": {
                        "type": "creraces:compare",
                        "value": "state:creraces:stored_material",
                        "to": 1,
                        "operator": ">="
                    },
                    "if_true": [
                        {
                            "type": "creraces:conditional",
                            "condition": {
                                "type": "creraces:can_place_block",
                                "position": { "from": "self", "y": -1 }
                            },
                            "if_true": [
                                {
                                    "type": "creraces:conditional",
                                    "condition": {
                                        "type": "creraces:compare",
                                        "value": "resource:mana",
                                        "to": 20,
                                        "operator": ">="
                                    },
                                    "if_true": [
                                        {
                                            "type": "creraces:place_block",
                                            "block": "creraces:volcanic_rock",
                                            "position": { "from": "self", "y": -1 }
                                        },
                                        {
                                            "type": "creraces:modify_value",
                                            "resource": "mana",
                                            "operation": "add",
                                            "value": -20
                                        },
                                        {
                                            "type": "creraces:modify_value",
                                            "state": "creraces:stored_material",
                                            "operation": "add",
                                            "value": -1
                                        },
                                        {
                                            "type": "creraces:modify_value",
                                            "cooldown": "creraces:magmamancy",
                                            "value": 2
                                        }
                                    ],
                                    "if_false": [
                                        {
                                            "type": "creraces:message",
                                            "text": "msg.creraces.oread.not_enough_mana",
                                            "actionbar": true
                                        }
                                    ]
                                }
                            ],
                            "if_false": [
                                {
                                    "type": "creraces:message",
                                    "text": "msg.creraces.oread.placement_blocked",
                                    "actionbar": true
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "creraces:on_deactivate": [{ "type": "creraces:modify_value", "state": "self", "value": 0 }],
    "creraces:wiki_page": "Ability:Magmamancy"
}
