{
  "multipart": [
    { "apply": { "model": "creraces:block/veil_willow_fence_post" } },
    { "when": { "north": "true" }, "apply": { "model": "creraces:block/veil_willow_fence", "uvlock": true } },
    { "when": { "south": "true" }, "apply": { "model": "creraces:block/veil_willow_fence", "y": 180, "uvlock": true } },
    { "when": { "west": "true" }, "apply": { "model": "creraces:block/veil_willow_fence", "y": 270, "uvlock": true } },
    { "when": { "east": "true" }, "apply": { "model": "creraces:block/veil_willow_fence", "y": 90, "uvlock": true } }
  ]
}
